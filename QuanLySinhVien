namespace QuanLySinhVien
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            int n = 0;
            while (n <= 0)
            {
                Console.Write("Nhập số lượng sinh viên trong lớp: ");
                if (!int.TryParse(Console.ReadLine(), out n) || n <= 0)
                {
                    Console.WriteLine("Số lượng không hợp lệ. Vui lòng nhập lại số nguyên dương!");
                }
            }

            string[] danhSachTen = new string[n];
            double[] danhSachDiem = new double[n];

            double tongDiem = 0;
            double diemMax = -1;
            string sinhVienMax = "";
            int soLuongDat = 0;

            Console.WriteLine("\n--- NHẬP THÔNG TIN SINH VIÊN ---");
            for (int i = 0; i < n; i++)
            {
                Console.WriteLine($"\nSinh viên thứ {i + 1}:");
                Console.Write("Họ và tên: ");
                danhSachTen[i] = Console.ReadLine();

                double diem = -1;
                while (diem < 0 || diem > 10)
                {
                    Console.Write("Điểm số (0.0 - 10.0): ");
                    if (!double.TryParse(Console.ReadLine(), out diem) || diem < 0 || diem > 10)
                    {
                        Console.WriteLine("Điểm số không hợp lệ. Vui lòng nhập lại!");
                        diem = -1;
                    }
                }
                danhSachDiem[i] = diem;

                tongDiem += diem;

                if (diem > diemMax)
                {
                    diemMax = diem;
                    sinhVienMax = danhSachTen[i];
                }

                if (diem >= 5.0)
                {
                    soLuongDat++;
                }
            }

            double diemTrungBinh = tongDiem / n;

            Console.WriteLine("\n================ DANH SÁCH SINH VIÊN ================");
            Console.WriteLine("{0,-5} | {1,-25} | {2,-10}", "STT", "Họ và tên", "Điểm số");
            Console.WriteLine("-----------------------------------------------------");
            for (int i = 0; i < n; i++)
            {
                Console.WriteLine("{0,-5} | {1,-25} | {2,-10:F2}", i + 1, danhSachTen[i], danhSachDiem[i]);
            }
            Console.WriteLine("=====================================================");

            Console.WriteLine("\n--- THỐNG KÊ LỚP HỌC ---");
            Console.WriteLine($"- Điểm trung bình cả lớp : {diemTrungBinh:F2}");
            Console.WriteLine($"- Số lượng sinh viên đạt (>= 5.0): {soLuongDat} sinh viên");
            Console.WriteLine($"- Sinh viên điểm cao nhất: {sinhVienMax} ({diemMax:F2} điểm)");

            Console.ReadLine();
        }
    }
}
